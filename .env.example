# Copy this file to .env and add your own provider credentials.
# Never paste these secret keys into index.html or a public frontend.

PORT=3000
HOST=0.0.0.0

# Optional official image-generation providers. Configure only the providers you use.
IDEOGRAM_API_KEY=
RECRAFT_API_TOKEN=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Apify is a general Actor platform, not one universal image model.
# Add the API token and exactly ONE target: an Actor ID OR a Task ID.
APIFY_API_TOKEN=
APIFY_IMAGE_ACTOR_ID=
APIFY_IMAGE_TASK_ID=
# Change the field names/values to match your Actor or Task input schema.
# Supported placeholders: {{prompt}}, {{negativePrompt}}, {{aspectRatio}},
# {{numberOfImages}}, {{resolution}}, {{width}}, {{height}}, {{styleName}},
# {{artStyle}}, and {{detailLevel}}.
APIFY_IMAGE_ACTOR_INPUT_JSON={"prompt":"{{prompt}}","aspectRatio":"{{aspectRatio}}","numberOfImages":"{{numberOfImages}}","resolution":"{{resolution}}"}

# Optional protection for a server exposed beyond your own computer.
# Use a long random value. The web UI will request it when this is configured.
STUDIO_ACCESS_KEY=
